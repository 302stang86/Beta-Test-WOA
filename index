<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Work Order Acknowledgment</title>

    <style>
        /* =========================================================
           BASIC PAGE SETTINGS
           ========================================================= */

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f2f2f2;
            margin: 0;
            padding: 20px;
            color: #222;
        }

        .container {
            max-width: 1000px;
            margin: auto;
            background: #fff;
            padding: 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        h1, h2, h3 {
            margin-top: 0;
        }

        h1 {
            text-align: center;
            border-bottom: 2px solid #222;
            padding-bottom: 15px;
        }

        h2 {
            background: #333;
            color: #fff;
            padding: 10px;
            margin-top: 30px;
        }

        /* =========================================================
           FORM ELEMENTS
           ========================================================= */

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

        input,
        textarea,
        select {
            width: 100%;
            box-sizing: border-box;
            padding: 9px;
            border: 1px solid #aaa;
            border-radius: 4px;
            font-size: 14px;
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 15px;
        }

        .form-row.three {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .field {
            margin-bottom: 15px;
        }

        /* =========================================================
           DEFICIENCY SECTION
           ========================================================= */

        .deficiency {
            border: 1px solid #aaa;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 5px;
        }

        .priority {
            font-weight: bold;
            padding: 8px;
            border-radius: 4px;
            margin-bottom: 10px;
        }

        .non-critical {
            background: #fff3a6;
        }

        .critical {
            background: #ffbd73;
        }

        .impaired {
            background: #ff7777;
            color: #000;
        }

        .deficiency-header {
            display: grid;
            grid-template-columns: 200px 1fr;
            gap: 15px;
        }

        /* =========================================================
           BUTTONS
           ========================================================= */

        button {
            padding: 10px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            background: #333;
            color: white;
            font-size: 14px;
            margin: 5px 5px 5px 0;
        }

        button:hover {
            background: #555;
        }

        .delete-button {
            background: #b00000;
        }

        .delete-button:hover {
            background: #800000;
        }

        .print-button {
            background: #005a9c;
        }

        /* =========================================================
           COMMENTS
           ========================================================= */

        .comment {
            border: 1px solid #ccc;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 5px;
        }

        .visibility {
            margin-top: 10px;
        }

        .visibility label {
            display: inline-block;
            font-weight: normal;
            margin-right: 15px;
        }

        .visibility input {
            width: auto;
        }

        /* =========================================================
           FILE ATTACHMENTS
           ========================================================= */

        .attachments {
            border: 2px dashed #aaa;
            padding: 20px;
            text-align: center;
            margin-bottom: 15px;
        }

        /* =========================================================
           SIGNATURE PAD
           ========================================================= */

        .signature-container {
            border: 1px solid #aaa;
            border-radius: 4px;
            background: white;
        }

        canvas {
            width: 100%;
            height: 180px;
            display: block;
            cursor: crosshair;
        }

        .signature-buttons {
            padding: 5px;
            text-align: right;
            border-top: 1px solid #ddd;
        }

        /* =========================================================
           LEGAL TERMS
           ========================================================= */

        .legal {
            background: #fafafa;
            border: 1px solid #ccc;
            padding: 15px;
        }

        .legal textarea {
            min-height: 250px;
        }

        /* =========================================================
           PRINT SETTINGS
           ========================================================= */

        @media print {

            body {
                background: white;
                padding: 0;
            }

            .container {
                box-shadow: none;
                max-width: none;
            }

            button,
            input[type="file"] {
                display: none;
            }

            h2 {
                color: black;
                background: white;
                border-bottom: 2px solid black;
            }
        }

        /* =========================================================
           MOBILE
           ========================================================= */

        @media (max-width: 700px) {

            .form-row,
            .form-row.three,
            .deficiency-header {
                grid-template-columns: 1fr;
            }

            .container {
                padding: 15px;
            }
        }
    </style>
</head>


<body>

<div class="container">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <h1>WORK ORDER ACKNOWLEDGMENT</h1>

    <div class="form-row">

        <div class="field">
            <label>Work Order Number</label>
            <input type="text" id="workOrderNumber">
        </div>

        <div class="field">
            <label>Date</label>
            <input type="date" id="workOrderDate">
        </div>

    </div>


    <!-- =========================================================
         CUSTOMER / JOB INFORMATION
         ========================================================= -->

    <h2>1. Customer / Job Information</h2>

    <div class="form-row">

        <div class="field">
            <label>Customer / Company</label>
            <input type="text">
        </div>

        <div class="field">
            <label>Customer Contact</label>
            <input type="text">
        </div>

    </div>

    <div class="form-row">

        <div class="field">
            <label>Job / Facility Name</label>
            <input type="text">
        </div>

        <div class="field">
            <label>Technician</label>
            <input type="text">
        </div>

    </div>

    <div class="field">
        <label>Service Address</label>
        <input type="text">
    </div>


    <!-- =========================================================
         SCOPE OF WORK
         ========================================================= -->

    <h2>2. Scope of Work Completed</h2>

    <div class="field">
        <label>Detailed Description of Work Performed</label>

        <textarea
            id="scopeOfWork"
            placeholder="Enter a detailed description of the work performed...">
        </textarea>

    </div>

    <div class="field">

        <label>Equipment / Systems Serviced</label>

        <textarea
            placeholder="List equipment, systems, devices, locations, identification numbers, etc.">
        </textarea>

    </div>


    <!-- =========================================================
         DEFICIENCIES
         ========================================================= -->

    <h2>3. Deficiencies Identified</h2>

    <p>
        Document deficiencies identified during the service.
        Select the appropriate priority.
    </p>

    <div id="deficiencies">

        <!-- First deficiency -->
        <div class="deficiency">

            <div class="deficiency-header">

                <div>
                    <label>Priority</label>

                    <select
                        class="priority-select"
                        onchange="updatePriority(this)">

                        <option value="non-critical">
                            Non-Critical
                        </option>

                        <option value="critical">
                            Critical
                        </option>

                        <option value="impaired">
                            Impaired
                        </option>

                    </select>

                </div>

                <div>
                    <label>Deficiency Description</label>

                    <input type="text"
                           placeholder="Describe the deficiency">
                </div>

            </div>

            <div class="field">

                <label>Recommended Corrective Action</label>

                <textarea
                    placeholder="Describe recommended corrective action...">
                </textarea>

            </div>

            <button
                type="button"
                class="delete-button"
                onclick="removeDeficiency(this)">
                Remove Deficiency
            </button>

        </div>

    </div>


    <button type="button" onclick="addDeficiency()">
        + Add Deficiency
    </button>


    <!-- =========================================================
         ITM REPORT
         ========================================================= -->

    <h2>4. ITM Report & Attachments</h2>

    <div class="attachments">

        <label>Attach Completed ITM Report</label>

        <input
            type="file"
            id="itmReport"
            accept=".pdf,.doc,.docx,.xls,.xlsx">

        <p>
            Upload the completed Inspection, Testing & Maintenance
            (ITM) report.
        </p>

    </div>


    <div class="attachments">

        <label>Attach Supporting ITM Documentation</label>

        <input
            type="file"
            id="itmAttachments"
            multiple
            accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx">

        <p>
            Photos, test sheets, inspection documents,
            equipment documentation, etc.
        </p>

    </div>


    <!-- =========================================================
         COMMENTS
         ========================================================= -->

    <h2>5. Comments</h2>

    <div id="comments">

        <div class="comment">

            <div class="field">

                <label>Comment</label>

                <textarea
                    placeholder="Enter comment...">
                </textarea>

            </div>

            <div class="visibility">

                <strong>Visibility:</strong>

                <label>
                    <input
                        type="radio"
                        name="commentVisibility1"
                        value="customer"
                        checked>

                    Visible to Customer
                </label>

                <label>
                    <input
                        type="radio"
                        name="commentVisibility1"
                        value="internal">

                    Internal Only
                </label>

            </div>

        </div>

    </div>


    <button type="button" onclick="addComment()">
        + Add Comment
    </button>


    <!-- =========================================================
         CUSTOMER ACKNOWLEDGMENT
         ========================================================= -->

    <h2>6. Customer Acknowledgment</h2>

    <p>
        By signing below, the customer acknowledges that the work
        described above was performed and that the information
        contained within this work order has been reviewed.
    </p>


    <!-- =========================================================
         TECHNICIAN SIGNATURE
         ========================================================= -->

    <div class="form-row">

        <div>

            <label>Technician Signature</label>

            <div class="signature-container">

                <canvas id="technicianSignature"></canvas>

                <div class="signature-buttons">

                    <button
                        type="button"
                        onclick="clearSignature('technicianSignature')">
                        Clear
                    </button>

                </div>

            </div>

            <label>Technician Name</label>
            <input type="text">

        </div>


        <!-- =====================================================
             CUSTOMER SIGNATURE
             ===================================================== -->

        <div>

            <label>Customer Signature</label>

            <div class="signature-container">

                <canvas id="customerSignature"></canvas>

                <div class="signature-buttons">

                    <button
                        type="button"
                        onclick="clearSignature('customerSignature')">
                        Clear
                    </button>

                </div>

            </div>

            <label>Customer Name</label>
            <input type="text">

        </div>

    </div>


    <div class="form-row">

        <div class="field">

            <label>Technician Signature Date</label>

            <input type="date" id="technicianDate">

        </div>

        <div class="field">

            <label>Customer Signature Date</label>

            <input type="date" id="customerDate">

        </div>

    </div>


    <!-- =========================================================
         TERMS AND CONDITIONS
         ========================================================= -->

    <h2>7. Terms & Conditions</h2>

    <div class="legal">

        <label>
            Legal Terms & Conditions
        </label>

        <textarea
            placeholder="ENTER YOUR COMPANY'S LEGAL TERMS AND CONDITIONS HERE.

Example placeholder:

1. Scope of Work
[Insert language.]

2. Payment Terms
[Insert language.]

3. Customer Responsibilities
[Insert language.]

4. Deficiencies and Recommended Repairs
[Insert language.]

5. Limitations of Inspection / Testing
[Insert language.]

6. Code Compliance
[Insert language.]

7. Warranty
[Insert language.]

8. Liability
[Insert language.]

9. Authorization
[Insert language.]

10. Additional Terms
[Insert language.]"></textarea>

    </div>


    <!-- =========================================================
         ACTION BUTTONS
         ========================================================= -->

    <br>

    <button
        type="button"
        class="print-button"
        onclick="window.print()">

        Print / Save as PDF

    </button>

    <button
        type="button"
        onclick="window.scrollTo(0,0)">

        Back to Top

    </button>


</div>


<!-- =============================================================
     JAVASCRIPT
     ============================================================= -->

<script>

    /* =========================================================
       AUTOMATIC TODAY'S DATE
       ========================================================= */

    function setTodaysDate() {

        const today = new Date();

        const yyyy = today.getFullYear();

        const mm = String(today.getMonth() + 1).padStart(2, '0');

        const dd = String(today.getDate()).padStart(2, '0');

        const formattedDate =
            yyyy + '-' + mm + '-' + dd;

        document.getElementById("workOrderDate").value =
            formattedDate;

        document.getElementById("technicianDate").value =
            formattedDate;

        document.getElementById("customerDate").value =
            formattedDate;
    }


    /* =========================================================
       DEFICIENCIES
       ========================================================= */

    function addDeficiency() {

        const container =
            document.getElementById("deficiencies");

        const div =
            document.createElement("div");

        div.className = "deficiency";

        div.innerHTML = `

            <div class="deficiency-header">

                <div>

                    <label>Priority</label>

                    <select
                        class="priority-select"
                        onchange="updatePriority(this)">

                        <option value="non-critical">
                            Non-Critical
                        </option>

                        <option value="critical">
                            Critical
                        </option>

                        <option value="impaired">
                            Impaired
                        </option>

                    </select>

                </div>

                <div>

                    <label>Deficiency Description</label>

                    <input
                        type="text"
                        placeholder="Describe the deficiency">

                </div>

            </div>

            <div class="field">

                <label>
                    Recommended Corrective Action
                </label>

                <textarea
                    placeholder="Describe recommended corrective action...">
                </textarea>

            </div>

            <button
                type="button"
                class="delete-button"
                onclick="removeDeficiency(this)">

                Remove Deficiency

            </button>
        `;

        container.appendChild(div);
    }


    function removeDeficiency(button) {

        const deficiency =
            button.closest(".deficiency");

        deficiency.remove();
    }


    /* =========================================================
       CHANGE PRIORITY COLOR
       ========================================================= */

    function updatePriority(select) {

        const deficiency =
            select.closest(".deficiency");

        deficiency.classList.remove(
            "non-critical",
            "critical",
            "impaired"
        );

        deficiency.classList.add(
            select.value
        );
    }


    /* =========================================================
       COMMENTS
       ========================================================= */

    let commentNumber = 1;


    function addComment() {

        commentNumber++;

        const container =
            document.getElementById("comments");

        const div =
            document.createElement("div");

        div.className = "comment";

        div.innerHTML = `

            <div class="field">

                <label>Comment</label>

                <textarea
                    placeholder="Enter comment...">
                </textarea>

            </div>

            <div class="visibility">

                <strong>Visibility:</strong>

                <label>

                    <input
                        type="radio"
                        name="commentVisibility${commentNumber}"
                        value="customer"
                        checked>

                    Visible to Customer

                </label>

                <label>

                    <input
                        type="radio"
                        name="commentVisibility${commentNumber}"
                        value="internal">

                    Internal Only

                </label>

            </div>

            <button
                type="button"
                class="delete-button"
                onclick="this.closest('.comment').remove()">

                Remove Comment

            </button>
        `;

        container.appendChild(div);
    }


    /* =========================================================
       SIGNATURE PAD
       ========================================================= */

    function setupSignature(canvasId) {

        const canvas =
            document.getElementById(canvasId);

        const ctx =
            canvas.getContext("2d");

        let drawing = false;


        function resizeCanvas() {

            const ratio =
                Math.max(window.devicePixelRatio || 1, 1);

            canvas.width =
                canvas.offsetWidth * ratio;

            canvas.height =
                canvas.offsetHeight * ratio;

            ctx.scale(ratio, ratio);
        }


        resizeCanvas();

        window.addEventListener(
            "resize",
            resizeCanvas
        );


        function getPosition(event) {

            const rect =
                canvas.getBoundingClientRect();

            return {
                x: event.clientX - rect.left,
                y: event.clientY - rect.top
            };
        }


        canvas.addEventListener(
            "pointerdown",
            function(event) {

                drawing = true;

                const pos =
                    getPosition(event);

                ctx.beginPath();

                ctx.moveTo(
                    pos.x,
                    pos.y
                );
            }
        );


        canvas.addEventListener(
            "pointermove",
            function(event) {

                if (!drawing) return;

                const pos =
                    getPosition(event);

                ctx.lineTo(
                    pos.x,
                    pos.y
                );

                ctx.stroke();
            }
        );


        canvas.addEventListener(
            "pointerup",
            function() {

                drawing = false;

            }
        );


        canvas.addEventListener(
            "pointerleave",
            function() {

                drawing = false;

            }
        );
    }


    function clearSignature(canvasId) {

        const canvas =
            document.getElementById(canvasId);

        const ctx =
            canvas.getContext("2d");

        ctx.clearRect(
            0,
            0,
            canvas.width,
            canvas.height
        );
    }


    /* =========================================================
       INITIALIZE
       ========================================================= */

    window.addEventListener(
        "DOMContentLoaded",
        function() {

            setTodaysDate();

            setupSignature(
                "technicianSignature"
            );

            setupSignature(
                "customerSignature"
            );

            // Initialize first deficiency color
            const firstPriority =
                document.querySelector(
                    ".priority-select"
                );

            if (firstPriority) {
                updatePriority(firstPriority);
            }

        }
    );

</script>

</body>
</html>
